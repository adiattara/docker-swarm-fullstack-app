# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env

# ─── PostgreSQL ───
PGUSER=fullstack_user
PGPASSWORD=change_me
PGHOST=localhost
PGPORT=5432
PGDATABASE=fullstack

# Docker secrets : chemin du fichier contenant le mot de passe
# (prioritaire sur PGPASSWORD si défini)
# PGPASSWORD_FILE=/run/secrets/db_password

# ─── Backend ───
PORT=3000

# ─── Frontend ───
FRONT_PORT=4200
API_URL=http://localhost:3000/api/items
