# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env

# ─── PostgreSQL (compose.pg.yml + backend Node) ───
POSTGRES_USER=fullstack_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fullstack

# Docker secrets : chemin du fichier contenant le mot de passe
# (prioritaire sur POSTGRES_PASSWORD si défini)
# PGPASSWORD_FILE=/run/secrets/db_password

# ─── Backend ───
PORT=3000

# ─── Frontend ───
FRONT_PORT=4200
API_URL=http://localhost:3000/api/items
