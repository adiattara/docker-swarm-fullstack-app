# Copier ce fichier en `.env` puis adapter les valeurs :
#   cp .env.example .env

# ─── PostgreSQL (compose.pg.yml) ───
POSTGRES_USER=fullstack_user
POSTGRES_DB=fullstack

# Le mot de passe n'est pas dans ce fichier : il est fourni par le secret
# Docker `db_password` (voir compose.pg.yml), monté dans /run/secrets/db_password.
# Créer le fichier source avant le premier `docker compose up` :
#   mkdir -p secrets
#   printf 'change_me' > secrets/db_password.txt

# ─── Backend ───
PORT=3000

# ─── Frontend ───
FRONT_PORT=4200
API_URL=http://localhost:3000/api/items
